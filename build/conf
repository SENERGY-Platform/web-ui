server {
  listen 80;
  listen [::]:80;
  index index.html;
  root /usr/share/nginx/html;

  location / {
    # /index.html as a URI, not a file, so deep links end up in the location below
    try_files $uri $uri/ /index.html;
  }

  # not content-hashed, so a browser has to revalidate them to pick up a release
  location = /index.html {
    add_header Cache-Control "no-cache";
  }

  location = /assets/env.js {
    add_header Cache-Control "no-cache";
  }
}
