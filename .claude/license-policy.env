# Licence policy of this repository, read by the pre-commit licence hooks.
#
# MPL-2.0 is allowed here for one dependency: @joint/core carries the diagram
# editor and the flow designer. MPL is copyleft per file - its own files stay
# under MPL and their source is published by the project, while the code beside
# them in the bundle is not covered, which is what separates it from the GPL
# family. Dropping it would mean rebuilding both editors. The dependency and the
# obligation that comes with it are recorded in THIRD-PARTY.md.
#
# Everything else keeps the default policy. MPL is removed from the header scan
# as well, so a file that names it is not reported either; that is the same
# decision, not a second one.

FORBIDDEN_LICENSES='gpl|agpl|lgpl|sspl|cc-by-nc|cc-by-sa|osl|epl|cddl|bsl|elastic-license|commons-clause'
ALLOWED_NPM='MIT;Apache-2.0;BSD-2-Clause;BSD-3-Clause;ISC;0BSD;Unlicense;CC0-1.0;Python-2.0;MPL-2.0'
